{
  "expo": {
    "name": "Noor-ul-Quran",
    "slug": "noor-reader",
    "scheme": "noor-ul-quran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/apkicon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#084F38"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.q9tech.noorulquran"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/apkicon.png",
        "backgroundColor": "#042317"
      },
      "package": "com.q9tech.noorulquran",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DigitalKhattIndoPak.otf",
            "./assets/fonts/AmiriQuran-Regular.ttf",
            "./assets/fonts/ScheherazadeNew-Regular.ttf",
            "./assets/fonts/UthmanHafs.ttf"
          ]
        }
      ]
    ]
  }
}

